# ── pons-volume-bot ──────────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit real keys.

# Robinhood Chain RPC (optional override)
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Trading wallet private key — required only for live mode
PRIVATE_KEY=

# Safety: live trading needs DRY_RUN=false AND CONFIRM_LIVE_TRADING=YES
DRY_RUN=true
CONFIRM_LIVE_TRADING=NO

# Emergency kill switch (false = halt all trade decisions)
BOT_ENABLED=true

# Optional: pin a token instead of auto-detecting launches
# TARGET_TOKEN=0x39dBED3a2bd333467115dE45665cC57F813C4571
